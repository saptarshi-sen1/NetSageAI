# Copy this file to .env (in the project root) and fill in your own values.
# NetSage AI works with ZERO configuration in mock/demo mode - leaving
# every key below blank is fully supported for coursework demos.

# ---------------------------------------------------------------------------
# Provider selection
# ---------------------------------------------------------------------------
# Leave blank to auto-detect: GEMINI_API_KEY -> Gemini, else mock/demo
# mode. Set explicitly to force a specific provider.
#   AI_PROVIDER=gemini | mock
AI_PROVIDER=

# ---------------------------------------------------------------------------
# Google Gemini
# ---------------------------------------------------------------------------
# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Primary model to try first.
GEMINI_MODEL=gemini-2.5-flash

# Comma-separated, in order. If the primary model's quota is exhausted
# (HTTP 429 / RESOURCE_EXHAUSTED), unavailable on your key/tier (404),
# or returns a server error after retrying, NetSage AI automatically
# retries the SAME request against the next model in this list - no
# code changes needed. Leave both GEMINI_MODEL and this blank to use
# the built-in default chain (see backend/ai/client.py::DEFAULT_GEMINI_MODEL_CHAIN).
GEMINI_FALLBACK_MODELS=gemini-2.5-flash-lite,gemini-2.0-flash-001,gemini-2.5-pro

NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=